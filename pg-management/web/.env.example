# PG Management client — build-time configuration
#
# Everything here is compiled into the APK, so treat the package as sensitive
# if you set the auto sign-in credentials below.

# --- Server -----------------------------------------------------------------
# The API address. Also changeable on the device, so one build can be pointed
# anywhere. Release builds refuse plain HTTP — use https:// outside development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Single-user mode -------------------------------------------------------
# Set both to skip the sign-in screen: the app signs itself in on launch and
# opens on the dashboard. Intended for the owner's own device.
#
# Authentication is not disabled by this — the server still authenticates every
# request, enforces role permissions and records who did what. It only removes
# the typing. The credentials do end up inside the APK, so anyone holding the
# file can read them; leave both blank to get the normal sign-in screen back.
NEXT_PUBLIC_AUTO_LOGIN_EMAIL=admin@pgmanagement.local
NEXT_PUBLIC_AUTO_LOGIN_PASSWORD=ChangeMe!2026
