# PG Management client — build-time configuration
#
# This is compiled into the APK, so it must contain nothing secret. The address
# below is all the app needs: it authenticates as a user and the API decides
# what that user may see.
#
# The address can also be changed on the device, under "Server settings" on the
# sign-in screen.
#
# Release builds refuse plain HTTP — use https:// for anything but local
# development.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
