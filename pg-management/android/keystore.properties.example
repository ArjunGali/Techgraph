# Copy to android/keystore.properties and fill in. Never commit the real file
# or the keystore itself — both are git-ignored.
#
# Create a keystore with:
#   keytool -genkeypair -v -keystore pg-management-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias pg-management
#
# Keep the .jks file and these passwords safe: Android will only accept an
# update to an installed app if it is signed with the same key.

storeFile=/absolute/path/to/pg-management-release.jks
storePassword=your-keystore-password
keyAlias=pg-management
keyPassword=your-key-password
