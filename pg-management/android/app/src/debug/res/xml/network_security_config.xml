<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Allows cleartext to loopback and the private ranges an emulator or a phone on
  the same Wi-Fi uses to reach a development server. This file is not part of
  the release build, so a shipped APK still refuses plain HTTP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- The host machine, as seen from the Android emulator. -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
    </domain-config>
</network-security-config>
