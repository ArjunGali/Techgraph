# PG Management API — environment
#
# Copy to server/.env and fill in. Never commit the real file.
# Only this service holds database credentials; the Android app never does.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- PostgreSQL ------------------------------------------------------------
# The only component that connects to the database.
DATABASE_URL=postgresql://user:password@localhost:5432/pg_management
# Set true for a managed database that requires TLS (most hosted providers).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- Authentication --------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
# Changing it signs every user out.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=12h
BCRYPT_ROUNDS=10

# --- File storage ----------------------------------------------------------
# Payment proofs and identity documents. Never served statically — every read
# goes through an authorised, audited endpoint. Back this directory up and keep
# it off any public path.
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=8388608

# --- API access ------------------------------------------------------------
# Comma-separated origins, or * in development. The packaged Android app sends
# its requests from https://localhost, which * covers.
CORS_ORIGINS=*

# --- Messaging -------------------------------------------------------------
# stub          — logs messages locally, sends nothing. Safe for development.
# whatsapp_cloud — the official WhatsApp Business Cloud API.
WHATSAPP_PROVIDER=stub
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Automation ------------------------------------------------------------
# Runs the scheduler inside the API process. Set false to drive the jobs from
# an external scheduler against /api/automation instead.
AUTOMATION_ENABLED=true

# --- Seeding ---------------------------------------------------------------
# Password given to the seeded accounts. Change it immediately after seeding.
# SEED_ADMIN_PASSWORD=
