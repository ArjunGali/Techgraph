# Integration test environment.
#
# Copy to server/.env.test. These tests run against a REAL PostgreSQL database
# and TRUNCATE every table between suites, so this must point at a throwaway
# database — never at development or production data.
#
#   createdb pg_management_test
#   cp server/.env.test.example server/.env.test
#   npm run migrate --workspace server   # with DATABASE_URL set to the test db
#   npm run test:integration --workspace server

NODE_ENV=test
DATABASE_URL=postgresql://user:password@localhost:5432/pg_management_test
JWT_SECRET=test-secret-key-that-is-long-enough-for-validation
STORAGE_DIR=./storage-test
# Kept low so the suite is not dominated by password hashing.
BCRYPT_ROUNDS=4
