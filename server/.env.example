# CognoDB connection (openCypher over Bolt, accessed with the official neo4j-driver).
# Copy this file to .env and fill in your CognoDB instance credentials.
# URI format: bolt+s://<host> (TLS) or bolt://<host>:7687 (local / unencrypted)
COGNODB_URI=bolt+s://your-cognodb-host
COGNODB_USERNAME=your-username
COGNODB_PASSWORD=your-password

# HTTP server
PORT=4000

# Set in production to the deployed frontend origin, e.g. https://techgraph.vercel.app
# CLIENT_ORIGIN=http://localhost:5173
